{
  "name": "dupetster-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "start:proxy": "node scripts/spotify-proxy.cjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:ci": "playwright test --project=chromium",
    "e2e:report": "playwright test && playwright show-report"
  },
  "private": true,
  "packageManager": "npm@11.10.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "jspdf": "^4.2.1",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
